# npm run setup generates a local .env and an administrator password.
PORT=3001
APP_ORIGIN=http://localhost:5173
DATABASE_PATH=./data/xiaoyuai.sqlite
# Optional: PostgreSQL takes priority over DATABASE_PATH. Keep real credentials private.
DATABASE_URL=
PAYMENT_MODE=merchant
# Stable private key for voucher encryption. Back up with the database; do not rotate without migration.
VOUCHER_SECRET=
ADMIN_PASSWORD_HASH=
# Switch to stripe only after configuring your verified merchant account.
# Stripe collects card details on its hosted page. Do not put card details here.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# WeChat Pay: enable Native payment in your own approved merchant account.
WECHATPAY_APP_ID=
WECHATPAY_MCH_ID=
WECHATPAY_CERT_SERIAL=
WECHATPAY_PRIVATE_KEY_PATH=.local/keys/wechat-merchant-private.pem
WECHATPAY_API_V3_KEY=
WECHATPAY_PLATFORM_KEY_ID=
WECHATPAY_PLATFORM_PUBLIC_KEY_PATH=.local/keys/wechat-platform-public.pem
# Alipay PagePay with RSA2 public-key mode.
ALIPAY_APP_ID=
ALIPAY_SELLER_ID=
ALIPAY_PRIVATE_KEY_PATH=.local/keys/alipay-app-private.pem
ALIPAY_PUBLIC_KEY_PATH=.local/keys/alipay-public.pem

# Generate once: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Back up with the database. Never replace this value during an ordinary redeploy.
